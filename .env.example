# ============================================================================
# RPC ENDPOINTS
# ============================================================================

# Gnosis Chain
RPC_URL_GNOSIS=https://rpc.gnosischain.com
# Or use Alchemy for better rate limits:
# RPC_URL_GNOSIS=https://gnosis-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Base
RPC_URL_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Or public RPC:
# RPC_URL_BASE=https://mainnet.base.org

# Base Sepolia (Testnet)
RPC_URL_BASE_TESTNET=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Or public RPC:
# RPC_URL_BASE_TESTNET=https://sepolia.base.org

# Arbitrum One
RPC_URL_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Or public RPC:
# RPC_URL_ARBITRUM=https://arb1.arbitrum.io/rpc

# Optimism
RPC_URL_OPTIMISM=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Or public RPC:
# RPC_URL_OPTIMISM=https://mainnet.optimism.io

# Polygon
RPC_URL_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
# Or public RPC:
# RPC_URL_POLYGON=https://polygon-rpc.com

# Celo
RPC_URL_CELO=https://forno.celo.org
# Or use Alchemy:
# RPC_URL_CELO=https://celo-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# ============================================================================
# BLOCK EXPLORER API KEYS
# ============================================================================

# Gnosis Chain (uses Etherscan API)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Base
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# Arbitrum
ARBISCAN_API_KEY=YOUR_ARBISCAN_API_KEY

# Optimism
OPTIMISTIC_ETHERSCAN_API_KEY=YOUR_OPTIMISTIC_ETHERSCAN_API_KEY

# Polygon
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY

# Celo
CELOSCAN_API_KEY=YOUR_CELOSCAN_API_KEY

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Alchemy RPC for Gnosis Chain frontend (recommended to avoid rate limits)
# Get your API key from: https://dashboard.alchemy.com/
NEXT_PUBLIC_ALCHEMY_GNOSIS_URL=https://gnosis-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# WalletConnect Project ID (required for RainbowKit)
# Get from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# The Graph API Key (optional, for production deployment)
# Get from: https://thegraph.com/studio/apikeys/
NEXT_PUBLIC_GRAPH_API_KEY=